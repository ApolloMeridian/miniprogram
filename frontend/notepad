def download_protocol(car_type_set: set[str]) -> tuple[dict, dict]:
    config_map = download_config_map()
    if config_map is None:
        config_map = {car_type: car_type for car_type in car_type_set}
    else:
        config_map = {
            key: val for key, val in config_map.items() if key in car_type_set
        }

    protocol_map = {}
    for car_type, val in config_map.items():
        if val in protocol_map:
            continue
        try:
            print(f"download protocol: {car_type}")
            param_config, sub_id_config = download_param_data(car_type)
            protocol_map[val] = json.dumps(
                {"data": param_config, "sub_id": sub_id_config}
            )
        except Exception as err:
            print(f"download protocol failed, car_type: {car_type}, message: {err}")

    return config_map, protocol_map



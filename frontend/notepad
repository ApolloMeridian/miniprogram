    serviceAccount: spark-operator-spark
    annotations:
      vault.hashicorp.com/agent-inject: "true"
      vault.hashicorp.com/role: "spark-k8s-role"
      vault.hashicorp.com/agent-inject-secret-minio-jwt: "identity/oidc/token/spark-minio-role"
      vault.hashicorp.com/agent-inject-template-minio-jwt: |
        {{- with secret "identity/oidc/token/spark-minio-role" -}}
        {{ .Data.token }}

def normalize_signals(signals: str) -> tuple[bool, list[str]]:
    if not isinstance(signals, str):
        raise TypeError("signals必须是字符串")
    value = signals.strip()
    if not value:
        raise ValueError("signals不能为空")
    if value.upper() == "ALL":
        return True, []

    signal_names = []
    seen = set()
    for item in value.split(","):
        signal = item.strip()
        if signal and signal not in seen:
            seen.add(signal)
            signal_names.append(signal)
    if not signal_names:
        raise ValueError("signals必须为ALL或至少包含一个有效信号名")
    return False, signal_names


def create_schema(
    is_all: bool,
    signal_names: list[str],
    do_callback: bool,
) -> tuple:
    pyarrow_header = [
        pa.field(name, arrow_type, nullable=True)
        for name, _, arrow_type in HEADER_FIELDS
    ]
    spark_header = [
        StructField(name, spark_type, True)
        for name, spark_type, _ in HEADER_FIELDS
    ]

    if is_all:
        map_value_arrow_type = pa.string() if do_callback else pa.float32()
        map_value_spark_type = StringType() if do_callback else FloatType()
        signal_fields_arrow = [
            pa.field(
                "signal",
                pa.map_(pa.string(), map_value_arrow_type),
                nullable=True,
            )
        ]
        signal_fields_spark = [
            StructField(
                "signal",
                MapType(StringType(), map_value_spark_type),
                True,
            )
        ]
    else:
        signal_arrow_type = pa.string() if do_callback else pa.float32()
        signal_spark_type = StringType() if do_callback else FloatType()
        signal_fields_arrow = [
            pa.field(signal, signal_arrow_type, nullable=True)
            for signal in signal_names
        ]
        signal_fields_spark = [
            StructField(signal, signal_spark_type, True)
            for signal in signal_names
        ]

    parsed_schema = pa.schema(signal_fields_arrow)
    output_schema = pa.schema(pyarrow_header + signal_fields_arrow)
    output_schema_spark = StructType(spark_header + signal_fields_spark)
    return parsed_schema, output_schema, output_schema_spark


def build_selected_output_names(
    signal_names: list[str],
    signal_metadata: dict[str, str],
) -> dict[str, str]:
    used_names = {"vin", *OUTPUT_COLUMN_NAMES.values()}
    result = {}
    for signal in signal_names:
        base_name = signal_metadata.get(signal, signal)
        output_name = base_name
        if output_name in used_names:
            output_name = f"{base_name}（{signal}）"
        suffix = 2
        while output_name in used_names:
            output_name = f"{base_name}（{signal}-{suffix}）"
            suffix += 1
        used_names.add(output_name)
        result[signal] = output_name
    return result



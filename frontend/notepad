    "spark.hadoop.fs.s3a.endpoint": "http://10.0.32.110:9000"
    "spark.hadoop.fs.s3a.connection.ssl.enabled": "false"
    "spark.hadoop.fs.s3a.path.style.access": "true"

  driver:
    cores: 1
    memory: "4g"
    labels:
      version: 3.4.0

    serviceAccount: spark-operator-spark
    annotations:
      vault.hashicorp.com/agent-inject: "true"
      vault.hashicorp.com/role: "spark-k8s-role" # 注意：这里用的是 spark 命名空间的 Role
      vault.hashicorp.com/agent-inject-secret-minio-jwt: "identity/oidc/token/spark-minio-role"
      vault.hashicorp.com/agent-inject-template-minio-jwt: |
        {{- with secret "identity/oidc/token/spark-minio-role" -}}
        {{ .Data.token }}
        {{- end -}}
    # 3. 给 Driver 容器注入环境变量
    env:
      - name: MY_NODE_IP
        valueFrom:
          fieldRef:
            fieldPath: status.hostIP
      - name: AWS_WEB_IDENTITY_TOKEN_FILE
        value: "/vault/secrets/minio-jwt"
      - name: AWS_ROLE_ARN

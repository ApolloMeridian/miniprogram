_EXPORT_PARSER_CACHE_KEY = None
_EXPORT_PARSER_CACHE = None


def create_export_parser(params):
    return Parser(
        signal_schema=params["signal_schema"],
        input_data=params["input_data"],
        vin_to_car_type=params["vin_to_car_type"],
        car_type_to_signal_model=params["car_type_to_signal_model"],
        protocol_flag=params["protocol_flag"],
        do_callback=params["do_callback"],
        signal_aliases=params["signal_aliases"],
    )


def acquire_export_parser(params):
    """Reuse one QB1S parser in each Spark Python worker process."""
    global _EXPORT_PARSER_CACHE_KEY, _EXPORT_PARSER_CACHE

    cache_key = params["parser_cache_key"]
    if (
        _EXPORT_PARSER_CACHE_KEY == cache_key
        and _EXPORT_PARSER_CACHE is not None
    ):
        return _EXPORT_PARSER_CACHE, True

    parser = create_export_parser(params)
    _EXPORT_PARSER_CACHE_KEY = cache_key
    _EXPORT_PARSER_CACHE = parser
    return parser, False


def discard_export_parser(cache_key, parser):
    global _EXPORT_PARSER_CACHE_KEY, _EXPORT_PARSER_CACHE

    if (
        _EXPORT_PARSER_CACHE_KEY == cache_key
        and _EXPORT_PARSER_CACHE is parser
    ):
        _EXPORT_PARSER_CACHE_KEY = None
        _EXPORT_PARSER_CACHE = None


def fetch_json_data(url: str, token=None) -> Optional[dict]:
    headers = {"Accept": "application/json"}
    if token is not None:
        headers["Authorization"] = f"Bearer {token}"

    # print(headers, url_string)
    with requests.get(
        url,
        headers=headers,
        timeout=int(os.getenv("QB_EXPORT_PROTOCOL_TIMEOUT", "30")),
    ) as response:
        response.raise_for_status()
        try:
            response_data = response.json()
            return response_data
        except Exception as e_parse:
            print(f"处理响应时发生错误: {e_parse}")
            return None


def request_data(url: str, token_url: Optional[str] = None) -> dict:
    if token_url is not None:
        token_response = fetch_json_data(token_url)
        if token_response is not None:
            token = token_response[
                os.getenv("QB_EXPORT_PLAIN_TOKEN_FIELD", "token")
            ]
    else:
        token = None

    return fetch_json_data(url, token)


def download_param_data(car_type: str) -> tuple:
    try:
        qb_url_car_type = qb_url.format(car_type=car_type)
    except (KeyError, IndexError):
        qb_url_car_type = qb_url.format(car_type)
    res = request_data(qb_url_car_type, token_url)
    param_data = res.get("data", None)
    sub_id_data = res.get("sub_id", None)
    return (param_data, sub_id_data)


def download_config_map() -> Optional[dict]:
    if not qb_config_url:
        return None
    return request_data(qb_config_url, token_url)["data"]


